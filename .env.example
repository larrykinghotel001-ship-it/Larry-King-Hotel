# ====================================================================
# LARRY KING HOTEL & SUITE — PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. APPLICATION & DOMAIN
APP_URL="https://larrykinghotel.com"
PORT=3000
NODE_ENV="development"

# 2. DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# The application automatically runs with persistent local storage when DATABASE_URL is not set.
# Provide this for direct connection to Supabase PostgreSQL:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-private-key"
SUPABASE_STORAGE_BUCKET="hotel-assets"

# 3. ADMIN AUTHENTICATION SECURITY
# A 32+ character random secret used to sign and verify administrator JWT session tokens:
ADMIN_JWT_SECRET="replace-with-a-secure-random-32-char-secret-string"
INITIAL_ADMIN_EMAIL="admin@larrykinghotel.com"
INITIAL_ADMIN_PASSWORD="ChangeThisStrongPassword2026!"

# 4. PAYSTACK PAYMENT GATEWAY (OPTIONAL / ONBOARDING)
# Obtain from Paystack Dashboard > Settings > API Keys & Webhooks.
# If keys are omitted, the booking engine seamlessly operates in 'Pay-at-Hotel' and 'Direct Bank Transfer' modes.
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_signature_secret"

# 5. TRANSACTIONAL EMAIL & NOTIFICATIONS
# E.g., Resend, SendGrid, or SMTP provider:
EMAIL_PROVIDER_API_KEY="re_your_transactional_email_api_key"
EMAIL_FROM="Larry King Hotel & Suite <Booking@larrykinghotel.com>"
HOTEL_NOTIFICATION_EMAIL="Info@larrykinghotel.com"

# 6. WHATSAPP CUSTOMER SERVICE CONTACT
# International format without '+' symbol for WhatsApp deep-links (e.g., 2349071286050):
WHATSAPP_PHONE_NUMBER="2349071286050"
HOTEL_PHONE_DISPLAY="+234-9071286050"
